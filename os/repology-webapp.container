[Unit]
Description=Repology webapp
Requires=repology-db.service
After=repology-db.service

[Container]
ContainerName=repology-webapp
Image=@WEBAPP_IMAGE@
Network=repology.network
PublishPort=8080:8080
Exec=--dsn postgresql://repology:repology@repology-db/repology --listen 0.0.0.0:8080
# It ignores SIGTERM: without this, every stop (reboots and OS updates included)
# waits the full 10 second default before podman kills it.
StopTimeout=2

[Service]
# The webapp exits when the database is unreachable at startup: wait for it to
# be healthy rather than crash-looping through the first import.
ExecStartPre=/bin/sh -c 'until podman healthcheck run repology-db >/dev/null 2>&1; do sleep 15; done'
TimeoutStartSec=4h
Restart=always
RestartSec=10

[Install]
# Pulled in by the database rather than by multi-user.target: a target waits for the
# units it wants, and this one waits out the whole first import, so the boot would
# stay "starting" (cloud-final included) for most of an hour.
WantedBy=repology-db.service
